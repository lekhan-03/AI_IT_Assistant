# Optional. If set, the assistant uses an LLM for triage reasoning and
# automatically falls back to the built-in rule engine if the API call
# fails or the model output can't be parsed. If left unset, the app runs
# entirely on the rule engine -- no external calls, no key required.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional. Defaults to 5000.
PORT=5000
